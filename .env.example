# Copy with: cp .env.example .env
# Local Docker Compose development only; replace credentials for deployment.

SERVER_APPENV=development
SERVER_NAME=mint-alternative
# Bind to all interfaces inside the app container.
SERVER_HOST=0.0.0.0
SERVER_DOMAIN=localhost
SERVER_PORT=3000
# Compose publishes the app on this host port.
PORT=3000
SERVER_LOGGING=true
SERVER_TLS_CERT_PATH=./cert/tls.crt
SERVER_TLS_KEY_PATH=./cert/tls.key
# Only the local immediate peer may supply forwarding headers by default.
SERVER_TRUSTED_PROXIES=127.0.0.1/32,::1/128

DB_NAME=mint_alternative
DB_USER=mint_alternative
DB_ROOT_PASSWORD=local_dev_password
DB_TIME_ZONE=UTC
# Trace SQL statements and arguments. Development only; keep off in production.
DB_LOG_QUERIES=false
# Compose service hostname; use localhost when running Go on the host.
# The shared local role owns application and River schemas for development.
DB_URL=postgresql://mint_alternative:local_dev_password@database:5432/mint_alternative?sslmode=disable
DB_ROOT_URL=postgresql://mint_alternative:local_dev_password@database:5432/mint_alternative?sslmode=disable
DB_RIVER_URL=postgresql://mint_alternative:local_dev_password@database:5432/mint_alternative?search_path=river_queue&sslmode=disable

RIVER_UI_USER=river
RIVER_UI_PASS=local_river_password

JWT_PUB_KEY_PATH=./cert/jwt-pub.pem
JWT_PVT_KEY_PATH=./cert/jwt-pvt.pem
JWT_ACCESS_EXPIRY_TIME=5m
JWT_REFRESH_EXPIRY_TIME=30m
